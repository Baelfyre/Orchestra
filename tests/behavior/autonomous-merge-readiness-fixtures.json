    {"id": "merge-conflict", "overrides": {"mergeable": false}, "expected_disposition": "BLOCK"},
    {"id": "mergeable-is-not-enough", "overrides": {"checks": null, "mergeable": true}, "expected_disposition": "WAIT_FOR_EVIDENCE"},
