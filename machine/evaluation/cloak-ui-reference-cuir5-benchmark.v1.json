  "cases": [
    {
      "id": "CUIR5-01",
      "task": "Design a multi-step signup form with password validation and clear field errors",
      "expected_patterns": ["cuir3.auth_and_multistep_form_flow", "cuir3.semantic_field_and_control_state"],
      "criteria": ["requirement_coverage", "accessibility_coverage", "design_consistency"]
    },
    {
      "id": "CUIR5-02",
      "task": "Show file upload progress with pause, resume, failure, and completion states",
      "expected_patterns": ["cuir3.operation_progress_lifecycle", "cuir3.outcome_feedback_and_empty_state"],
      "criteria": ["requirement_coverage", "responsive_coverage", "accessibility_coverage"]
    },
    {
      "id": "CUIR5-03",
      "task": "Separate delete account from routine settings actions and require a clear destructive path",
      "expected_patterns": ["cuir3.action_priority_and_destructive_separation"],
      "criteria": ["requirement_coverage", "design_consistency"]
    },
    {
      "id": "CUIR5-04",
      "task": "Create a collapsed sidebar with a clear selected destination and keyboard-usable controls",
      "expected_patterns": ["cuir3.destination_state_navigation"],
      "criteria": ["requirement_coverage", "accessibility_coverage", "responsive_coverage"]
    },
    {
      "id": "CUIR5-05",
      "task": "Choose general interface icons and a brand logo while preserving the correct reuse and rights treatment",
      "expected_patterns": ["cuir3.general_ui_icon_system", "cuir3.brand_icon_traceability_and_rights"],
      "criteria": ["provenance_correctness", "license_reuse_correctness"]
    },
    {
      "id": "CUIR5-06",
      "task": "Design an accordion settings panel with one section expanded and explicit selected state",
      "expected_patterns": ["cuir3.selection_and_disclosure_state"],
      "criteria": ["requirement_coverage", "accessibility_coverage"]
    }
  ],
  "pass_thresholds": {
    "expected_pattern_recall": 0.8,
    "provenance_completeness": 1.0,
    "bounded_context_compliance": 1.0,
    "authority_boundary_compliance": 1.0,
