{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Baelfyre/Orchestra/blob/main/machine/schemas/prai-post-run-assurance.v1.schema.json",
  "title": "Orchestra PRAI Post-Run Assurance Work Unit",
  "description": "Strict schema for independently bound PRAI work-unit evidence and its non-authorizing decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_item_ref",
    "repository",
    "source_ref",
    "candidate_sha",
    "tree_sha",
    "freshness_ref",
    "version_ref",
    "changed_paths",
    "implementer",
    "logical_impact",
    "security_impact",
    "audit_depth",
    "required_reviewers",
    "required_additional_assurance",
    "logical_result",
    "security_result",
    "evidence_refs",
    "limitations",
    "overseer_sufficiency",
    "arbiter_disposition",
    "review_receipts",
    "authority_boundary",
    "risk_characteristics",
    "invariants",
    "logical_findings",
    "security_findings",
    "caller_contract_issues",
    "policy_modified_paths",
    "policy_self_modification",
    "authority_expansion",
    "green_tests",
    "security_classification"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "orchestra.post-run-assurance.v1"
    },
    "work_item_ref": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "candidate_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "tree_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "freshness_ref": {
      "type": "string",
      "format": "date-time"
    },
    "version_ref": {
      "type": "string",
      "minLength": 1
    },
    "changed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "implementer": {
      "type": "string",
      "minLength": 1
    },
    "logical_impact": {
      "type": "string",
      "enum": [
        "NONE",
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "security_impact": {
      "type": "string",
      "enum": [
        "NONE",
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "audit_depth": {
      "type": "string",
      "enum": [
        "LIGHT",
        "STANDARD",
        "DEEP"
      ]
    },
    "required_reviewers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "CLOCKWORK",
          "CIPHER",
          "OVERSEER",
          "CHRONICLER",
          "DAGGER",
          "STEWARD",
          "GOVERNOR",
          "CLOAK",
          "CI",
          "GENERIC_CI"
        ]
      },
      "uniqueItems": true
    },
    "required_additional_assurance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "logical_result": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "security_result": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "overseer_sufficiency": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "enum": [
            "SUFFICIENT",
            "INSUFFICIENT"
          ]
        }
      ]
    },
    "arbiter_disposition": {
      "type": "string",
      "enum": [
        "AUTO_CONTINUE",
        "AUTO_REMEDIATE_AND_REVALIDATE",
        "WAIT_FOR_EVIDENCE",
        "WAIT_FOR_CAPACITY",
        "ESCALATE_HUMAN",
        "STOP"
      ]
    },
    "review_receipts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/receipt"
      }
    },
    "authority_boundary": {
      "type": "string",
      "const": "EVIDENCE_ONLY_NON_AUTHORIZING"
    },
    "risk_characteristics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "enum": [
          "ACCESSIBILITY",
          "AGGREGATE_INVARIANTS",
          "AUTHENTICATION",
          "AUTHORIZATION",
          "CAPACITY",
          "COMPLIANCE",
          "CONCURRENCY",
          "DATA_OWNERSHIP",
          "DESTRUCTIVE_LIFECYCLE",
          "DURABILITY",
          "EXTERNAL_INPUT",
          "IP",
          "LEGAL",
          "MIGRATION",
          "PARTIAL_FAILURE",
          "PERSISTENCE",
          "POLICY",
          "PRIVACY",
          "PRIVILEGE",
          "PRODUCT",
          "PRODUCTION_CRITICAL",
          "RECOVERY",
          "RESOURCE_ALLOCATION",
          "RESOURCE_PRESSURE",
          "RETRY_IDEMPOTENCY",
          "SCOPE_EXPANSION",
          "SENSITIVE_PROVENANCE",
          "STATE_MACHINE",
          "TENANT_ISOLATION",
          "TRANSACTION",
          "UI",
          "UX",
          "VISUAL"
        ]
      },
      "uniqueItems": true
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "logical_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "security_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "caller_contract_issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "policy_modified_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "policy_self_modification": {
      "type": "boolean"
    },
    "authority_expansion": {
      "type": "boolean"
    },
    "green_tests": {
      "type": "boolean"
    },
    "security_classification": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "receipt_id",
        "role",
        "reviewer",
        "result",
        "repository",
        "source_ref",
        "candidate_sha",
        "tree_sha",
        "work_item_ref",
        "audit_depth",
        "evidence_refs",
        "audited_paths",
        "evidence_layer",
        "evidence_scope",
        "covered_risks",
        "covered_invariants",
        "freshness_ref",
        "version_ref",
        "provenance",
        "independent",
        "producer",
        "validator",
        "claim_scope",
        "limitations",
        "examined_changed_code",
        "security_classification",
        "logical_identity"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "orchestra.post-run-assurance.v1"
        },
        "receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "CLOCKWORK",
            "CIPHER",
            "OVERSEER",
            "CHRONICLER",
            "DAGGER",
            "STEWARD",
            "GOVERNOR",
            "CLOAK",
            "CI",
            "GENERIC_CI"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED"
          ]
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "candidate_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "work_item_ref": {
          "type": "string",
          "minLength": 1
        },
        "audit_depth": {
          "type": "string",
          "enum": [
            "LIGHT",
            "STANDARD",
            "DEEP"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "audited_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "evidence_layer": {
          "type": "string",
          "enum": [
            "STATIC",
            "UNIT",
            "DOMAIN",
            "CONTRACT",
            "INTEGRATION",
            "HTTP",
            "RUNTIME",
            "PERSISTENCE",
            "CONCURRENCY",
            "SECURITY",
            "PROVENANCE",
            "MUTATION",
            "ADVERSARIAL",
            "DOCUMENTATION",
            "COMPLETION_STATE"
          ]
        },
        "evidence_scope": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "SOURCE",
            "COMPLETION",
            "DOMAIN",
            "APPLICATION",
            "API",
            "UI",
            "UNIT",
            "CONTRACT",
            "INTEGRATION",
            "RUNTIME",
            "PERSISTENCE",
            "CONCURRENCY",
            "SECURITY",
            "ADVERSARIAL",
            "CANONICAL",
            "PRODUCT",
            "EMPIRICAL_EFFECTIVENESS"
          ]
        },
        "covered_risks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "covered_invariants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "freshness_ref": {
          "type": "string",
          "format": "date-time"
        },
        "version_ref": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "string",
          "enum": [
            "AUTHORITATIVE",
            "SELF_ASSERTED",
            "UNQUALIFIED"
          ]
        },
        "independent": {
          "type": "boolean"
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "validator": {
          "type": "string",
          "minLength": 1
        },
        "claim_scope": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "SOURCE",
            "COMPLETION",
            "DOMAIN",
            "APPLICATION",
            "API",
            "UI",
            "UNIT",
            "CONTRACT",
            "INTEGRATION",
            "RUNTIME",
            "PERSISTENCE",
            "CONCURRENCY",
            "SECURITY",
            "ADVERSARIAL",
            "CANONICAL",
            "PRODUCT",
            "EMPIRICAL_EFFECTIVENESS"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "examined_changed_code": {
          "type": "boolean"
        },
        "security_classification": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "logical_identity": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "decision_id",
        "repository",
        "source_ref",
        "candidate_sha",
        "tree_sha",
        "work_item_ref",
        "version_ref",
        "result",
        "compliant",
        "failure_codes",
        "required_reviewers",
        "satisfied_reviewers",
        "required_additional_assurance",
        "satisfied_additional_assurance",
        "audit_depth",
        "evidence_receipt_ids",
        "authority_model",
        "authority_expansion",
        "generated_at",
        "limitations",
        "decision_digest"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "orchestra.post-run-assurance-decision.v1"
        },
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "candidate_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "work_item_ref": {
          "type": "string",
          "minLength": 1
        },
        "version_ref": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "string",
          "enum": [
            "PASS",
            "BLOCKED"
          ]
        },
        "compliant": {
          "type": "boolean"
        },
        "failure_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "required_reviewers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "CLOCKWORK",
              "CIPHER",
              "OVERSEER",
              "CHRONICLER",
              "DAGGER",
              "STEWARD",
              "GOVERNOR",
              "CLOAK",
              "CI",
              "GENERIC_CI"
            ]
          },
          "uniqueItems": true
        },
        "satisfied_reviewers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "CLOCKWORK",
              "CIPHER",
              "OVERSEER",
              "CHRONICLER",
              "DAGGER",
              "STEWARD",
              "GOVERNOR",
              "CLOAK",
              "CI",
              "GENERIC_CI"
            ]
          },
          "uniqueItems": true
        },
        "required_additional_assurance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "satisfied_additional_assurance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "audit_depth": {
          "type": "string",
          "enum": [
            "LIGHT",
            "STANDARD",
            "DEEP"
          ]
        },
        "evidence_receipt_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "authority_model": {
          "type": "string",
          "const": "EVIDENCE_ONLY_NON_AUTHORIZING"
        },
        "authority_expansion": {
          "type": "boolean"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "decision_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
