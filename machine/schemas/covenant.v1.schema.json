{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Baelfyre/Orchestra/blob/main/machine/schemas/covenant.v1.schema.json",
  "title": "Orchestra Covenant v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_name",
    "authority_model",
    "prime_directive_ref",
    "human_contract_ref",
    "legacy_assurance_engine",
    "judgment_owners",
    "constitutional_precedence",
    "dispositions",
    "alignment_states",
    "reconciliation_invariants",
    "required_scenario_classes"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "orchestra.covenant.v1"},
    "contract_name": {"const": "TheCovenant"},
    "authority_model": {"const": "EVIDENCE_ONLY_NON_AUTHORIZING"},
    "prime_directive_ref": {"type": "string", "minLength": 1},
    "human_contract_ref": {"type": "string", "minLength": 1},
    "legacy_assurance_engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "contract_ref", "relationship", "prai_pass_sufficient_for_covenant_pass"],
      "properties": {
        "name": {"const": "PRAI"},
        "contract_ref": {"type": "string", "minLength": 1},
        "relationship": {"const": "EVIDENCE_INPUT_NOT_FINAL_SYSTEM_JUDGMENT"},
        "prai_pass_sufficient_for_covenant_pass": {"const": false}
      }
    },
    "judgment_owners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["STEWARD", "GOVERNOR"],
      "properties": {
        "STEWARD": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "GOVERNOR": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "constitutional_precedence": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "dispositions": {
      "type": "array",
      "uniqueItems": true,
      "const": ["PASS", "RECONCILED_WITH_CONSTRAINTS", "REVISION_REQUIRED", "WAIT_FOR_EVIDENCE", "ESCALATE_HUMAN", "BLOCKED"]
    },
    "alignment_states": {
      "type": "array",
      "uniqueItems": true,
      "const": ["ALIGNED", "CONFLICT", "UNKNOWN", "NOT_APPLICABLE"]
    },
    "reconciliation_invariants": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "required_scenario_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
