{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Baelfyre/Orchestra/blob/main/machine/schemas/uix9b-live-call-authorization.v2.schema.json",
  "title": "Orchestra UIX-9B V2 Human Live Call Authorization Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "role", "authorization_status", "canonical_sha", "fixture_digest", "task_digest", "validator_digest", "uix_guidance_digest", "evaluator_version", "evaluator_digest", "provider", "model", "model_revision", "codex_cli_version", "host_os", "arm_count", "repetitions_per_arm", "execution_order", "maximum_live_calls", "current_request_max_new_live_calls", "token_or_compute_ceiling", "per_run_timeout_seconds", "retry_policy", "invalid_run_policy", "outage_policy", "primary_endpoints", "secondary_endpoints", "result_classification_rules", "external_mutation_boundary", "evidence_retention_paths", "stop_conditions", "historical_counters", "new_campaign_authorization_counters", "live_model_calls_authorized", "provider_calls_authorized", "uix9c_execution_authorized"],
  "properties": {
    "$schema": {"const": "../../../machine/schemas/uix9b-live-call-authorization.v2.schema.json"},
    "schema_version": {"const": "uix9b.live-call-authorization.v2"},
    "role": {"const": "UIX_9B_HUMAN_LIVE_CALL_AUTHORIZATION_REQUEST"},
    "authorization_status": {"enum": ["PENDING_HUMAN_AUTHORIZATION", "APPROVED", "REJECTED"]},
    "canonical_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "fixture_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validator_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uix_guidance_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluator_version": {"const": "uix9b-live-metric-evaluator-v2.0.0"},
    "evaluator_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider": {"const": "openai-codex"},
    "model": {"const": "gpt-5.6-luna"},
    "model_revision": {"type": "string", "minLength": 1},
    "codex_cli_version": {"type": "string", "minLength": 1},
    "host_os": {"type": "string", "minLength": 1},
    "arm_count": {"const": 2},
    "repetitions_per_arm": {"const": 3},
    "execution_order": {"const": ["A1", "B1", "B2", "A2", "A3", "B3"]},
    "maximum_live_calls": {"const": 6},
    "current_request_max_new_live_calls": {"type": "integer", "minimum": 0, "maximum": 6},
    "token_or_compute_ceiling": {"const": "MAX_TOTAL_TOKENS_120000_MAX_PER_RUN_20000"},
    "per_run_timeout_seconds": {"const": 900},
    "retry_policy": {"type": "string", "minLength": 1},
    "invalid_run_policy": {"type": "string", "minLength": 1},
    "outage_policy": {"type": "string", "minLength": 1},
    "primary_endpoints": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "secondary_endpoints": {"type": "array", "items": {"type": "string"}},
    "result_classification_rules": {"type": "object", "additionalProperties": false, "required": ["allowed", "benefit_established", "no_benefit_established", "mixed_or_inconclusive", "protocol_invalid"], "properties": {"allowed": {"const": ["BENEFIT_ESTABLISHED", "NO_BENEFIT_ESTABLISHED", "MIXED_OR_INCONCLUSIVE", "PROTOCOL_INVALID"]}, "benefit_established": {"type": "array"}, "no_benefit_established": {"type": "string"}, "mixed_or_inconclusive": {"type": "array"}, "protocol_invalid": {"type": "string"}}},
    "external_mutation_boundary": {"type": "object", "additionalProperties": false, "required": ["max_external_repo_mutations", "prohibited_targets", "secrets_or_customer_data", "deployment", "policy_activation"], "properties": {"max_external_repo_mutations": {"const": 0}, "prohibited_targets": {"type": "array", "minItems": 1}, "secrets_or_customer_data": {"const": false}, "deployment": {"const": false}, "policy_activation": {"const": false}}},
    "evidence_retention_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "historical_counters": {"$ref": "#/$defs/counters"},
    "new_campaign_authorization_counters": {"$ref": "#/$defs/counters"},
    "live_model_calls_authorized": {"type": "boolean"},
    "provider_calls_authorized": {"type": "boolean"},
    "uix9c_execution_authorized": {"type": "boolean"}
  },
  "$defs": {"counters": {"type": "object", "additionalProperties": false, "required": ["experimental_model_calls", "experimental_provider_calls", "nonexperimental_availability_probes", "total_provider_interactions", "invalid_infrastructure_retries"], "properties": {"experimental_model_calls": {"type": "integer", "minimum": 0}, "experimental_provider_calls": {"type": "integer", "minimum": 0}, "nonexperimental_availability_probes": {"type": "integer", "minimum": 0}, "total_provider_interactions": {"type": "integer", "minimum": 0}, "invalid_infrastructure_retries": {"type": "integer", "minimum": 0}}}},
  "allOf": [
    {
      "if": {"properties": {"authorization_status": {"const": "APPROVED"}}},
      "then": {
        "properties": {
          "current_request_max_new_live_calls": {"const": 6},
          "live_model_calls_authorized": {"const": true},
          "provider_calls_authorized": {"const": true},
          "uix9c_execution_authorized": {"const": true}
        }
      },
      "else": {
        "properties": {
          "current_request_max_new_live_calls": {"const": 0},
          "live_model_calls_authorized": {"const": false},
          "provider_calls_authorized": {"const": false},
          "uix9c_execution_authorized": {"const": false}
        }
      }
    }
  ]
}
