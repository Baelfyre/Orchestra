{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestra.local/schemas/specialist-review-result.v1.schema.json",
  "title": "Orchestra Substantive Specialist Review Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_version", "review_id", "review_digest", "request_id", "request_digest",
    "operation_id", "specialist", "status", "conclusion", "findings", "evidence_refs",
    "workspace_snapshot_digest"
  ],
  "properties": {
    "review_version": {"const": "orchestra.specialist-review-result.v1"},
    "review_id": {"type": "string", "pattern": "^specialist-review\\.[0-9a-f]{24}$"},
    "review_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_id": {"type": "string", "minLength": 1},
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operation_id": {"const": "defensive-security-review"},
    "specialist": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "FINDINGS", "INCONCLUSIVE", "BLOCKED"]},
    "conclusion": {"type": "string", "minLength": 1},
    "findings": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "evidence_refs": {
      "type": "array", "items": {"type": "string", "minLength": 1},
      "minItems": 1, "uniqueItems": true
    },
    "workspace_snapshot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
