{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Baelfyre/Orchestra/blob/main/machine/schemas/agentic-workflow-profile.v1.schema.json",
  "title": "Orchestra Agentic Workflow Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "source_task_id",
    "selected_by",
    "primary_owner",
    "required_specialists",
    "selected_patterns",
    "sequence",
    "parallel_groups",
    "concurrency_mode",
    "max_parallel_specialists",
    "human_gate_required",
    "escalation_reasons",
    "stop_conditions",
    "critic_contract_id",
    "topology_effective",
    "topology_change_requires_human_approval",
    "authority_expansion"
  ],
  "properties": {
    "schema_version": {
      "const": "orchestra.agentic-workflow-profile.v1"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "selected_by": {
      "const": "conductor"
    },
    "primary_owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "required_specialists": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "selected_patterns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ROUTING",
          "PLANNING",
          "TOOL_REACT",
          "REFLECTION_CRITIC",
          "MULTI_AGENT"
        ]
      }
    },
    "sequence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "parallel_groups": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 14,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "concurrency_mode": {
      "enum": [
        "SINGLE_OWNER",
        "SEQUENTIAL_MULTI_AGENT",
        "PARALLEL_MULTI_AGENT"
      ]
    },
    "max_parallel_specialists": {
      "type": "integer",
      "minimum": 1
    },
    "human_gate_required": {
      "type": "boolean"
    },
    "escalation_reasons": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "critic_contract_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "topology_effective": {
      "const": true
    },
    "topology_change_requires_human_approval": {
      "const": false
    },
    "authority_expansion": {
      "const": false
    }
  }
}
