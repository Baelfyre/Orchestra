{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestra.padayon-memory-backend-profile.v1",
  "title": "Padayon Backend Profile for Orchestra Portable Memory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "pattern", "evidence", "privacy", "authority", "destination"],
  "properties": {
    "schema_version": {"const": "orchestra.portable-memory-candidate.v1"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "candidate_id", "source_schema_version", "learner_rule_version", "status", "shadow_only", "promotion_state"],
      "properties": {
        "system": {"const": "ORCHESTRA_ADAPTIVE_A3"},
        "candidate_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "source_schema_version": {"const": "orchestra.adaptive-shadow-candidate.v1"},
        "learner_rule_version": {"const": "orchestra.adaptive-shadow-rules.v1"},
        "status": {"const": "CANDIDATE"},
        "shadow_only": {"const": true},
        "promotion_state": {"const": "NOT_PROMOTED"}
      }
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "category", "value", "scope", "tags"],
      "properties": {
        "key": {"type": "string", "pattern": "^(?!(?:authority|capability|required_specialist|governance|human_gate|security_prohibition|mandatory_validation|evidence_integrity|audit_requirement|fail_closed|exact_head|release_gate|merge_gate|privacy_restriction|provider_restriction|resource_ceiling)(?:[.:]|$))[a-z0-9][a-z0-9_.:-]{0,127}$"},
        "type": {"enum": ["USER_PREFERENCE", "WORKFLOW_PATTERN", "SPECIALIST_STRATEGY"]},
        "category": {"enum": ["ARCHITECTURE", "CODE_REVIEW", "CONTEXT_RETRIEVAL", "DESIGN_UI_UX", "DOCUMENTATION", "REMEDIATION", "RESEARCH", "TESTING", "TOOLING", "VALIDATION", "WORKFLOW"]},
        "value": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 512}, {"type": "number"}, {"type": "boolean"}]},
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repositories", "projects", "use_cases", "specialists"],
          "properties": {
            "repositories": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}},
            "projects": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
            "use_cases": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
            "specialists": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}}
          }
        },
        "tags": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["refs", "digests", "distinct_support_count", "confidence", "confidence_method", "first_seen", "last_seen"],
      "properties": {
        "refs": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "digests": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "distinct_support_count": {"type": "integer", "minimum": 2},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence_method": {"const": "BOUNDED_EVIDENCE_ACCUMULATION_V1"},
        "first_seen": {"type": "string", "format": "date-time"},
        "last_seen": {"type": "string", "format": "date-time"}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_raw_conversation", "contains_sensitive_data", "contains_credentials", "user_key_transferred", "task_session_key_transferred", "review_state"],
      "properties": {
        "contains_raw_conversation": {"const": false},
        "contains_sensitive_data": {"const": false},
        "contains_credentials": {"const": false},
        "user_key_transferred": {"const": false},
        "task_session_key_transferred": {"const": false},
        "review_state": {"const": "EXPLICITLY_REVIEWED_FOR_PORTABLE_PROMOTION"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_authority", "policy_authority", "may_override_explicit_instruction", "may_relax_governance", "automatic_promotion"],
      "properties": {
        "execution_authority": {"const": false},
        "policy_authority": {"const": false},
        "may_override_explicit_instruction": {"const": false},
        "may_relax_governance": {"const": false},
        "automatic_promotion": {"const": false}
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend_id", "adapter_kind", "record_format", "state", "canonical_write_authorized", "created_at", "config_ref"],
      "properties": {
        "backend_id": {"const": "padayon"},
        "adapter_kind": {"const": "GIT_JSON"},
        "record_format": {"const": "JSON"},
        "state": {"const": "PENDING_BACKEND_VALIDATION"},
        "canonical_write_authorized": {"const": false},
        "created_at": {"type": "string", "format": "date-time"},
        "config_ref": {"const": "machine/adaptive/memory-backends.v1.json#padayon"}
      }
    }
  },
  "$defs": {"slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$"}}
}
