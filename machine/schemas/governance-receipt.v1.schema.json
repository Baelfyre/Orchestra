{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestra.local/schemas/governance-receipt.v1.schema.json",
  "title": "Orchestra Trusted Governance Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_or_receipt_id",
    "human_authority_source",
    "human_authority_id",
    "repository",
    "candidate_base",
    "candidate_head",
    "candidate_tree",
    "protected_rule",
    "allowed_operations",
    "allowed_scope",
    "evidence_references",
    "evidence_digest",
    "issued_at",
    "expires_at",
    "issued_execution_context_id",
    "execution_context_binding",
    "fresh_execution_context_required",
    "consumption_semantics"
  ],
  "properties": {
    "schema_version": {"const": "orchestra.governance-receipt.v1"},
    "decision_or_receipt_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$"},
    "human_authority_source": {"const": "HUMAN_GOVERNANCE_DECISION"},
    "human_authority_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "repository": {"type": "string", "pattern": "^[a-z0-9_.-]+/[a-z0-9_.-]+$"},
    "candidate_base": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "protected_rule": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$"},
    "allowed_operations": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "allowed_scope": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "evidence_references": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "issued_execution_context_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$"},
    "execution_context_binding": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$"},
    "fresh_execution_context_required": {"const": true},
    "consumption_semantics": {"const": "SINGLE_USE"}
  }
}
