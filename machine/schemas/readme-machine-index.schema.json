{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Baelfyre/Orchestra/blob/main/machine/schemas/readme-machine-index.schema.json",
  "title": "Orchestra Machine README Index v2",
  "description": "Schema for Orchestra's AI-facing repository discovery index. The index is derived and parity-validated; referenced machine contracts retain authority for their owned facts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "document_role",
    "authority",
    "human_readme",
    "human_documentation_map",
    "repository",
    "purpose",
    "capabilities",
    "machine_scan_order",
    "machine_contracts",
    "specialists",
    "governance",
    "architecture",
    "hosts_integrations",
    "knowledge_provenance",
    "validation",
    "continuity",
    "release_state",
    "documentation",
    "representation_policy",
    "maturity",
    "ai_review_guidance"
  ],
  "properties": {
    "$schema": {"type": "string", "const": "./machine/schemas/readme-machine-index.schema.json"},
    "schema_version": {"type": "string", "const": "orchestra.readme-machine-index.v2"},
    "document_role": {"type": "string", "const": "machine_repository_index"},
    "authority": {"type": "string", "const": "derived_and_parity_validated_projection"},
    "human_readme": {"type": "string", "const": "README.md"},
    "human_documentation_map": {"type": "string", "const": "docs/README.md"},
    "repository": {"type": "object"},
    "purpose": {"type": "object"},
    "capabilities": {"type": "object"},
    "machine_scan_order": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "path", "purpose"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "path": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    },
    "machine_contracts": {"type": "object"},
    "specialists": {"type": "object"},
    "governance": {"type": "object"},
    "architecture": {"type": "object"},
    "hosts_integrations": {"type": "object"},
    "knowledge_provenance": {"type": "object"},
    "validation": {"type": "object"},
    "continuity": {"type": "object"},
    "release_state": {"type": "object"},
    "documentation": {"type": "object"},
    "representation_policy": {"type": "object"},
    "maturity": {"type": "object"},
    "ai_review_guidance": {"type": "object"}
  }
}
