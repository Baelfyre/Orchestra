{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestra.local/schemas/adaptive-profile.schema.json",
  "title": "Orchestra Adaptive Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "memory_rule_version",
    "profile_id",
    "user_key",
    "generated_at",
    "source_head_digest",
    "patterns"
  ],
  "properties": {
    "schema_version": {"const": "orchestra.adaptive-profile.v1"},
    "memory_rule_version": {"const": "orchestra.adaptive-memory-rules.v1"},
    "profile_id": {"type": "string", "minLength": 1},
    "user_key": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_head_digest": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "patterns": {
      "type": "array",
      "items": {"$ref": "#/$defs/pattern"}
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "required": ["scope_type", "user_key"],
      "properties": {
        "scope_type": {"enum": ["global_user", "project", "specialist", "task_session"]},
        "user_key": {"type": "string", "minLength": 1},
        "project_key": {"type": "string", "minLength": 1},
        "specialist_slug": {"type": "string", "minLength": 1},
        "task_session_key": {"type": "string", "minLength": 1}
      }
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern_id",
        "scope",
        "subject_key",
        "value",
        "status",
        "evidence_class",
        "evidence_refs",
        "observation_count",
        "confidence",
        "created_at",
        "updated_at",
        "memory_rule_version"
      ],
      "properties": {
        "pattern_id": {"type": "string", "minLength": 1},
        "scope": {"$ref": "#/$defs/scope"},
        "subject_key": {
          "type": "string",
          "pattern": "^(?!(?:authority|capability|required_specialist|governance|human_gate|security_prohibition|mandatory_validation|evidence_integrity|audit_requirement|fail_closed|exact_head|release_gate|merge_gate|privacy_restriction|provider_restriction|resource_ceiling)(?:[.:]|$))[a-z0-9][a-z0-9_.:-]{0,127}$"
        },
        "value": {},
        "status": {"enum": ["candidate", "confirmed", "deprecated", "rejected"]},
        "evidence_class": {
          "enum": [
            "EXPLICIT_CURRENT_INSTRUCTION",
            "EXPLICIT_SCOPED_PREFERENCE",
            "USER_FEEDBACK",
            "INFERRED_CANDIDATE"
          ]
        },
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "observation_count": {"type": "integer", "minimum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "memory_rule_version": {"const": "orchestra.adaptive-memory-rules.v1"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
