{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Baelfyre/Orchestra/blob/main/machine/schemas/uix9b-live-proof-observation.v2.schema.json",
  "title": "Orchestra UIX-9B V2 Live Proof Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "role", "run_id", "arm_id", "pair_id", "repetition", "execution_order", "provider", "model", "model_revision", "reasoning_effort", "codex_cli_version", "host_os", "starting_fixture_digest", "requirements_digest", "task_digest", "prompt_digest", "guidance_digest_or_NONE", "validator_digest", "evaluator_version", "evaluator_digest", "metric_result_digest", "starting_tree", "final_tree", "changed_file_manifest", "git_diff_digest", "build_result", "test_result", "validator_result", "primary_metrics", "secondary_metrics", "failure_codes", "model_call_count", "provider_call_count", "token_counts_if_trustworthy", "start_timestamp", "end_timestamp", "run_classification", "outage_or_invalid_reason", "external_side_effects"],
  "properties": {
    "$schema": {"const": "../../../machine/schemas/uix9b-live-proof-observation.v2.schema.json"},
    "schema_version": {"const": "orchestra.uix9b-live-proof-observation.v2"},
    "role": {"const": "UIX_9B_LIVE_PROOF_OBSERVATION"},
    "run_id": {"type": "string", "pattern": "^(A|B)[1-3]$"},
    "arm_id": {"enum": ["BASELINE_NO_ORCHESTRA_UIX_GUIDANCE", "GOVERNED_CANONICAL_UIX_1_8_GUIDANCE"]},
    "pair_id": {"enum": ["PAIR_1", "PAIR_2", "PAIR_3"]},
    "repetition": {"type": "integer", "minimum": 1, "maximum": 3},
    "execution_order": {"type": "integer", "minimum": 1, "maximum": 6},
    "provider": {"const": "openai-codex"},
    "model": {"const": "gpt-5.6-luna"},
    "model_revision": {"type": "string", "minLength": 1},
    "reasoning_effort": {"const": "xhigh"},
    "codex_cli_version": {"type": "string", "minLength": 1},
    "host_os": {"type": "string", "minLength": 1},
    "starting_fixture_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requirements_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prompt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "guidance_digest_or_NONE": {"type": "string", "pattern": "^(NONE|[0-9a-f]{64})$"},
    "validator_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluator_version": {"const": "uix9b-live-metric-evaluator-v2.0.0"},
    "evaluator_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metric_result_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "starting_tree": {"$ref": "#/$defs/tree"},
    "final_tree": {"$ref": "#/$defs/tree"},
    "changed_file_manifest": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "git_diff_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "build_result": {"$ref": "#/$defs/check"},
    "test_result": {"$ref": "#/$defs/check"},
    "validator_result": {"$ref": "#/$defs/check"},
    "primary_metrics": {"$ref": "#/$defs/primaryMetrics"},
    "secondary_metrics": {"$ref": "#/$defs/secondaryMetrics"},
    "failure_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "model_call_count": {"const": 0},
    "provider_call_count": {"const": 0},
    "token_counts_if_trustworthy": {"$ref": "#/$defs/tokenCounts"},
    "start_timestamp": {"type": ["string", "null"]},
    "end_timestamp": {"type": ["string", "null"]},
    "run_classification": {"enum": ["ZERO_CALL_CANARY_PASS", "ZERO_CALL_CANARY_FAIL_CLOSED", "VALID_UNFAVORABLE_OUTPUT", "PROVIDER_OUTAGE", "HOST_CRASH", "RESOURCE_CEILING_EXCEEDED", "PROTOCOL_BREACH"]},
    "outage_or_invalid_reason": {"type": ["string", "null"]},
    "external_side_effects": {"$ref": "#/$defs/sideEffects"}
  },
  "$defs": {
    "tree": {"type": "object", "additionalProperties": false, "required": ["digest", "files"], "properties": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "files": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}},
    "check": {"type": "object", "additionalProperties": false, "required": ["status", "deterministic", "details"], "properties": {"status": {"enum": ["PASS", "FAIL", "NOT_RUN", "UNAVAILABLE"]}, "deterministic": {"type": "boolean"}, "details": {"type": "string", "minLength": 1}}},
    "primaryMetrics": {"type": "object", "additionalProperties": false, "required": ["COMPONENT_REUSE", "DUPLICATE_COMPONENT_COUNT", "TOKEN_VIOLATIONS", "ARBITRARY_STYLE_DRIFT", "STATE_COVERAGE", "ASSET_PROVENANCE", "ASSET_SUBSTITUTION", "RESPONSIVE_CONTAINMENT", "ACCESSIBILITY_INVARIANTS", "UNRESOLVED_MAPPINGS", "REVISION_MISMATCH", "VISUAL_BASELINE_REPLACEMENT", "DETERMINISTIC_ACCEPTANCE"], "properties": {"COMPONENT_REUSE": {"type": "boolean"}, "DUPLICATE_COMPONENT_COUNT": {"type": "integer", "minimum": 0}, "TOKEN_VIOLATIONS": {"type": "integer", "minimum": 0}, "ARBITRARY_STYLE_DRIFT": {"type": "integer", "minimum": 0}, "STATE_COVERAGE": {"type": "number", "minimum": 0, "maximum": 1}, "ASSET_PROVENANCE": {"type": "boolean"}, "ASSET_SUBSTITUTION": {"type": "boolean"}, "RESPONSIVE_CONTAINMENT": {"type": "boolean"}, "ACCESSIBILITY_INVARIANTS": {"type": "boolean"}, "UNRESOLVED_MAPPINGS": {"type": "integer", "minimum": 0}, "REVISION_MISMATCH": {"type": "boolean"}, "VISUAL_BASELINE_REPLACEMENT": {"type": "boolean"}, "DETERMINISTIC_ACCEPTANCE": {"type": "boolean"}}},
    "secondaryMetrics": {"type": "object", "additionalProperties": false, "required": ["IMPLEMENTATION_DIFF_SIZE", "NEW_COMPONENT_COUNT", "NEW_ARBITRARY_TOKEN_VALUE_COUNT", "VALIDATION_REMEDIATION_COUNT", "WALL_CLOCK_EXECUTION_TIME", "INPUT_TOKENS", "OUTPUT_TOKENS", "TOTAL_TOKENS", "metric_status"], "properties": {"IMPLEMENTATION_DIFF_SIZE": {"type": ["integer", "null"], "minimum": 0}, "NEW_COMPONENT_COUNT": {"type": ["integer", "null"], "minimum": 0}, "NEW_ARBITRARY_TOKEN_VALUE_COUNT": {"type": ["integer", "null"], "minimum": 0}, "VALIDATION_REMEDIATION_COUNT": {"type": ["integer", "null"], "minimum": 0}, "WALL_CLOCK_EXECUTION_TIME": {"type": ["number", "null"], "minimum": 0}, "INPUT_TOKENS": {"type": ["integer", "null"], "minimum": 0}, "OUTPUT_TOKENS": {"type": ["integer", "null"], "minimum": 0}, "TOTAL_TOKENS": {"type": ["integer", "null"], "minimum": 0}, "metric_status": {"type": "object", "additionalProperties": false, "required": ["WALL_CLOCK_EXECUTION_TIME", "INPUT_TOKENS", "OUTPUT_TOKENS", "TOTAL_TOKENS"], "properties": {"WALL_CLOCK_EXECUTION_TIME": {"enum": ["AVAILABLE", "UNAVAILABLE"]}, "INPUT_TOKENS": {"enum": ["AVAILABLE", "UNAVAILABLE"]}, "OUTPUT_TOKENS": {"enum": ["AVAILABLE", "UNAVAILABLE"]}, "TOTAL_TOKENS": {"enum": ["AVAILABLE", "UNAVAILABLE"]}}}}},
    "tokenCounts": {"type": "object", "additionalProperties": false, "required": ["status", "input", "output", "total"], "properties": {"status": {"enum": ["TRUSTWORTHY", "UNAVAILABLE"]}, "input": {"type": ["integer", "null"], "minimum": 0}, "output": {"type": ["integer", "null"], "minimum": 0}, "total": {"type": ["integer", "null"], "minimum": 0}}},
    "sideEffects": {"type": "object", "additionalProperties": false, "required": ["model_calls", "provider_calls", "external_repo_mutations", "orderly_mutations", "padayon_mutations", "registry_mutations", "production_mutations", "installed_integration_mutations", "release_tag_mutations", "deployments", "secrets_or_customer_data_used"], "properties": {"model_calls": {"const": 0}, "provider_calls": {"const": 0}, "external_repo_mutations": {"const": 0}, "orderly_mutations": {"const": 0}, "padayon_mutations": {"const": 0}, "registry_mutations": {"const": 0}, "production_mutations": {"const": 0}, "installed_integration_mutations": {"const": 0}, "release_tag_mutations": {"const": 0}, "deployments": {"const": 0}, "secrets_or_customer_data_used": {"const": false}}}
  }
}
