{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Baelfyre/Orchestra/blob/main/machine/schemas/ui-implementation-profile.v1.schema.json",
  "title": "Orchestra UI Implementation Profile Contract v1",
  "description": "Library-neutral, evidence-bound machine contract distinguishing MINIMAL_SAFE from UI_CONTRACT_FIDELITY implementation profiles.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "profile",
    "selected_by",
    "selection_reason",
    "required_fidelity",
    "allowed_deviations",
    "authority"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "orchestra.ui-implementation-profile.v1"
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "enum": [
        "MINIMAL_SAFE",
        "UI_CONTRACT_FIDELITY"
      ]
    },
    "selected_by": {
      "enum": [
        "conductor"
      ]
    },
    "selection_reason": {
      "type": "string",
      "minLength": 1
    },
    "design_contract_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "cloak_handoff_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "pattern_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/patternRef"
      }
    },
    "composition_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/compositionRef"
      }
    },
    "clockwork_boundary_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "execution_mode": {
      "enum": [
        "DETERMINISTIC_TEST_ENGINE",
        "HOST_NATIVE"
      ]
    },
    "required_fidelity": {
      "$ref": "#/$defs/requiredFidelity"
    },
    "allowed_deviations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/allowedDeviation"
      }
    },
    "authority": {
      "$ref": "#/$defs/authority"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "const": "UI_CONTRACT_FIDELITY"
          }
        }
      },
      "then": {
        "required": [
          "design_contract_ref",
          "cloak_handoff_ref",
          "pattern_refs",
          "composition_refs",
          "clockwork_boundary_ref"
        ],
        "properties": {
          "design_contract_ref": {
            "type": "string",
            "minLength": 1
          },
          "cloak_handoff_ref": {
            "type": "string",
            "minLength": 1
          },
          "pattern_refs": {
            "type": "array",
            "minItems": 1
          },
          "composition_refs": {
            "type": "array",
            "minItems": 1
          },
          "clockwork_boundary_ref": {
            "type": "string",
            "minLength": 1
          },
          "required_fidelity": {
            "properties": {
              "preserve_macro_composition": {
                "const": true
              },
              "preserve_visual_hierarchy": {
                "const": true
              },
              "preserve_interaction_states": {
                "const": true
              },
              "preserve_responsive_transformation": {
                "const": true
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "patternRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern_id",
        "source_kind",
        "reference_ref",
        "advisory_only"
      ],
      "properties": {
        "pattern_id": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "enum": [
            "CUIR_NORMALIZED",
            "PROJECT_NATIVE",
            "OPEN_SOURCE_COMPONENT",
            "PUBLIC_PROVIDER_GUIDANCE",
            "OBSERVED_PROVIDER_OUTPUT"
          ]
        },
        "reference_ref": {
          "type": "string",
          "minLength": 1
        },
        "advisory_only": {
          "type": "boolean"
        }
      }
    },
    "compositionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composition_id",
        "structural_role",
        "reference_ref"
      ],
      "properties": {
        "composition_id": {
          "type": "string",
          "minLength": 1
        },
        "structural_role": {
          "enum": [
            "MACRO_LAYOUT",
            "VISUAL_HIERARCHY",
            "INFORMATION_ARCHITECTURE",
            "RESPONSIVE_TRANSFORMATION",
            "OPTICAL_BALANCE",
            "INTERACTION_FLOW"
          ]
        },
        "reference_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requiredFidelity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preserve_macro_composition",
        "preserve_visual_hierarchy",
        "preserve_interaction_states",
        "preserve_responsive_transformation"
      ],
      "properties": {
        "preserve_macro_composition": {
          "type": "boolean"
        },
        "preserve_visual_hierarchy": {
          "type": "boolean"
        },
        "preserve_interaction_states": {
          "type": "boolean"
        },
        "preserve_responsive_transformation": {
          "type": "boolean"
        },
        "min_accessibility_level": {
          "enum": [
            "NONE",
            "WCAG_AA",
            "WCAG_AAA"
          ],
          "default": "WCAG_AA"
        },
        "optical_balance_required": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "allowedDeviation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_ref",
        "deviation_type",
        "reason",
        "approved_by"
      ],
      "properties": {
        "item_ref": {
          "type": "string",
          "minLength": 1
        },
        "deviation_type": {
          "enum": [
            "PERFORMANCE_SIMPLIFICATION",
            "TECHNICAL_CONSTRAINT",
            "DELIBERATE_ADAPTATION",
            "UNSUPPORTED_EFFECT"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "approved_by": {
          "enum": [
            "conductor",
            "the-steward",
            "human_maintainer"
          ]
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grants_specialist_authority",
        "grants_implementation_authority",
        "ponytail_can_self_select",
        "ponytail_can_downgrade"
      ],
      "properties": {
        "grants_specialist_authority": {
          "const": false
        },
        "grants_implementation_authority": {
          "const": false
        },
        "ponytail_can_self_select": {
          "const": false
        },
        "ponytail_can_downgrade": {
          "const": false
        }
      }
    }
  }
}
