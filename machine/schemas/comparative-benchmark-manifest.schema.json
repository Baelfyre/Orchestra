{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Baelfyre/Orchestra/blob/main/machine/schemas/comparative-benchmark-manifest.schema.json",
  "title": "Orchestra Comparative Benchmark Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "program_id", "experiment_id", "experiment_kind", "stage", "randomization_seed", "repetitions_per_arm", "common_control_identity", "arms", "tasks"],
  "properties": {
    "schema_version": {"const": "orchestra.comparative-benchmark-manifest.v1"},
    "program_id": {"const": "orchestra.shared-comparative-benchmark.v1"},
    "experiment_id": {"type": "string", "minLength": 1},
    "experiment_kind": {"enum": ["A5_ISOLATED", "MURMURS_ISOLATED", "A5_MURMURS_INTERACTION"]},
    "stage": {"enum": ["CALIBRATION", "PILOT", "CONFIRMATORY"]},
    "randomization_seed": {"type": "integer", "minimum": 0},
    "repetitions_per_arm": {"type": "integer", "minimum": 1},
    "executor_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400, "default": 600},
    "common_control_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orchestra_revision", "repository_revision", "system_instruction_digest", "provider", "model", "model_revision", "reasoning_setting", "temperature", "tool_access_digest", "specialist_set_digest", "required_specialist_set_digest", "authority_digest", "governance_digest", "validation_contract_digest", "environment_digest", "retry_policy_digest", "resource_budget_digest"],
      "properties": {
        "orchestra_revision": {"type": "string", "minLength": 1},
        "repository_revision": {"type": "string", "minLength": 1},
        "system_instruction_digest": {"$ref": "#/$defs/digest"},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "model_revision": {"type": ["string", "null"]},
        "reasoning_setting": {"type": ["string", "null"]},
        "temperature": {"type": ["number", "null"]},
        "tool_access_digest": {"$ref": "#/$defs/digest"},
        "specialist_set_digest": {"$ref": "#/$defs/digest"},
        "required_specialist_set_digest": {"$ref": "#/$defs/digest"},
        "authority_digest": {"$ref": "#/$defs/digest"},
        "governance_digest": {"$ref": "#/$defs/digest"},
        "validation_contract_digest": {"$ref": "#/$defs/digest"},
        "environment_digest": {"$ref": "#/$defs/digest"},
        "retry_policy_digest": {"$ref": "#/$defs/digest"},
        "resource_budget_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "arms": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/arm"}},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "task_class", "starting_state_digest", "task_prompt_digest", "task_payload"],
        "properties": {
          "task_id": {"type": "string", "minLength": 1},
          "task_class": {"enum": ["SINGLE_DOMAIN", "MULTI_DOMAIN", "ARCHITECTURE_HEAVY", "DEBUGGING", "SECURITY_SENSITIVE", "VALIDATION_HEAVY", "DOCUMENTATION_AND_IMPLEMENTATION", "DEPENDENCY_HEAVY", "PARALLEL_FRIENDLY", "HIGH_COORDINATION"]},
          "starting_state_digest": {"$ref": "#/$defs/digest"},
          "task_prompt_digest": {"$ref": "#/$defs/digest"},
          "task_payload": {"type": "object"}
        }
      }
    },
    "a5_evaluation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["eligibility_envelope_digest", "eligible_topology_candidate_ids"],
      "properties": {
        "eligibility_envelope_digest": {"$ref": "#/$defs/digest"},
        "eligible_topology_candidate_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "murmurs_evaluation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["same_counter_identity_for_token_delta"],
      "properties": {"same_counter_identity_for_token_delta": {"const": true}}
    },
    "interaction_evaluation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["isolated_a5_evidence_digest", "isolated_murmurs_evidence_digest"],
      "properties": {
        "isolated_a5_evidence_digest": {"$ref": "#/$defs/digest"},
        "isolated_murmurs_evidence_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "preregistration_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "benefit_thresholds": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["task_success_absolute_improvement", "remediation_relative_reduction", "fresh_token_relative_reduction", "latency_relative_reduction"],
      "properties": {
        "task_success_absolute_improvement": {"type": ["number", "null"], "minimum": 0},
        "remediation_relative_reduction": {"type": ["number", "null"], "minimum": 0},
        "fresh_token_relative_reduction": {"type": ["number", "null"], "minimum": 0},
        "latency_relative_reduction": {"type": ["number", "null"], "minimum": 0}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arm_id", "topology_candidate_id", "topology_class", "topology_digest", "communication_mode"],
      "properties": {
        "arm_id": {"type": "string", "minLength": 1},
        "topology_candidate_id": {"type": "string", "minLength": 1},
        "topology_class": {"enum": ["FIXED_DETERMINISTIC", "SEQUENTIAL", "CENTRALIZED_STAR", "HIERARCHICAL_DECOMPOSITION", "PARALLEL_JOIN", "OTHER_PERMITTED"]},
        "topology_digest": {"$ref": "#/$defs/digest"},
        "communication_mode": {"enum": ["DEFAULT", "CAVEMAN", "MURMURS"]}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"experiment_kind": {"const": "A5_ISOLATED"}}},
      "then": {"required": ["a5_evaluation"], "properties": {"a5_evaluation": {"type": "object"}, "murmurs_evaluation": {"type": ["null"]}, "interaction_evaluation": {"type": ["null"]}, "arms": {"items": {"properties": {"communication_mode": {"const": "DEFAULT"}}}}}}
    },
    {
      "if": {"properties": {"experiment_kind": {"const": "MURMURS_ISOLATED"}}},
      "then": {"required": ["murmurs_evaluation"], "properties": {"a5_evaluation": {"type": ["null"]}, "murmurs_evaluation": {"type": "object"}, "interaction_evaluation": {"type": ["null"]}, "arms": {"items": {"properties": {"topology_class": {"const": "FIXED_DETERMINISTIC"}}}}}}
    },
    {
      "if": {"properties": {"experiment_kind": {"const": "A5_MURMURS_INTERACTION"}}},
      "then": {"required": ["a5_evaluation", "murmurs_evaluation", "interaction_evaluation"], "properties": {"a5_evaluation": {"type": "object"}, "murmurs_evaluation": {"type": "object"}, "interaction_evaluation": {"type": "object"}}}
    },
    {
      "if": {"properties": {"stage": {"const": "CONFIRMATORY"}}},
      "then": {"required": ["preregistration_digest", "benefit_thresholds"], "properties": {"preregistration_digest": {"type": "string"}, "benefit_thresholds": {"type": "object"}}}
    }
  ]
}
