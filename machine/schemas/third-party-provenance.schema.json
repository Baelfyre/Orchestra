{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestra.local/schemas/third-party-provenance.schema.json",
  "title": "Orchestra Third-Party Provenance Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_on", "policy", "summary", "items"],
  "properties": {
    "schema_version": {"const": "orchestra.third-party-provenance.v1"},
    "updated_on": {"type": "string", "format": "date"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_classifications",
        "new_incorporation_requires_provenance_update",
        "vendored_or_copied_code_requires_license_review",
        "reference_only_is_not_runtime_authority",
        "semantic_context_required_for_references",
        "unknown_historical_facts_must_remain_unknown"
      ],
      "properties": {
        "allowed_classifications": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "TEST_TOOL_DEPENDENCY",
              "REFERENCE_ONLY",
              "PROTOCOL_STANDARD_REFERENCE",
              "HISTORICAL_RESEARCH_REFERENCE",
              "EVALUATED_OR_PLANNED_REFERENCE",
              "INTEGRATED_RUNTIME_DEPENDENCY",
              "VENDORED_OR_COPIED_CODE"
            ]
          }
        },
        "new_incorporation_requires_provenance_update": {"const": true},
        "vendored_or_copied_code_requires_license_review": {"const": true},
        "reference_only_is_not_runtime_authority": {"const": true},
        "semantic_context_required_for_references": {"const": true},
        "unknown_historical_facts_must_remain_unknown": {"const": true}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_items",
        "classification_counts",
        "re_foundation_vendored_or_copied_third_party_source_count",
        "re_foundation_new_runtime_dependency_count",
        "re_foundation_test_tool_dependency_count"
      ],
      "properties": {
        "total_items": {"type": "integer", "minimum": 0},
        "classification_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "re_foundation_vendored_or_copied_third_party_source_count": {"type": "integer", "minimum": 0},
        "re_foundation_new_runtime_dependency_count": {"type": "integer", "minimum": 0},
        "re_foundation_test_tool_dependency_count": {"type": "integer", "minimum": 0}
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "classification",
          "status",
          "version",
          "upstream_repository",
          "package_source",
          "reviewed_revision",
          "license",
          "purpose",
          "incorporated_or_learned_patterns",
          "runtime_dependency",
          "source_copied_or_vendored",
          "upstream_source_adapted",
          "orchestra_surfaces",
          "evidence"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "classification": {
            "enum": [
              "TEST_TOOL_DEPENDENCY",
              "REFERENCE_ONLY",
              "PROTOCOL_STANDARD_REFERENCE",
              "HISTORICAL_RESEARCH_REFERENCE",
              "EVALUATED_OR_PLANNED_REFERENCE",
              "INTEGRATED_RUNTIME_DEPENDENCY",
              "VENDORED_OR_COPIED_CODE"
            ]
          },
          "status": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "upstream_repository": {"type": "string", "format": "uri"},
          "package_source": {"type": ["string", "null"], "format": "uri"},
          "reviewed_revision": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "value", "branch"],
            "properties": {
              "status": {"type": "string", "minLength": 1},
              "value": {"type": ["string", "null"]},
              "branch": {"type": ["string", "null"]}
            }
          },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": ["spdx", "status"],
            "properties": {
              "spdx": {"type": "string", "minLength": 1},
              "status": {"type": "string", "minLength": 1}
            }
          },
          "purpose": {"type": "string", "minLength": 1},
          "incorporated_or_learned_patterns": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "runtime_dependency": {"type": "boolean"},
          "source_copied_or_vendored": {"type": "boolean"},
          "upstream_source_adapted": {"type": "boolean"},
          "orchestra_surfaces": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "reference", "description"],
              "properties": {
                "type": {"type": "string", "minLength": 1},
                "reference": {"type": "string", "minLength": 1},
                "description": {"type": "string", "minLength": 1}
              }
            }
          },
          "notes": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
