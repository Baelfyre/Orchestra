{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Baelfyre/Orchestra/machine/schemas/cloak-ui-reference-analysis-record.v1.schema.json",
  "title": "Cloak UI Reference Static Analysis Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "analysis_id",
    "source_record_path",
    "repository",
    "source_revision",
    "source_category",
    "analysis_mode",
    "inspected_paths",
    "candidate_patterns",
    "interaction_states",
    "accessibility_note",
    "inherited_reuse_classification",
    "review_owner"
  ],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "analysis_id": {"type": "string", "pattern": "^[a-z0-9.-]+\\.cuir2$"},
    "source_record_path": {"type": "string", "pattern": "^machine/provenance/cloak-ui-reference-cuir1/sources/.+\\.json$"},
    "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_category": {"enum": ["UI_REFERENCE", "BRAND_ICONS", "GENERAL_UI_ICONS"]},
    "analysis_mode": {"const": "STATIC_ONLY"},
    "inspected_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "candidate_patterns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
    "interaction_states": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
    "accessibility_note": {"type": "string", "minLength": 1},
    "inherited_reuse_classification": {"enum": ["REFERENCE_ONLY", "REUSE_WITH_NOTICE", "REUSE_WITH_RIGHTS_REVIEW", "PROHIBITED"]},
    "review_owner": {"const": "Cloak"}
  }
}
