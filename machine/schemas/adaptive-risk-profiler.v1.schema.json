{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Baelfyre/Orchestra/schemas/adaptive-risk-profiler.v1.schema.json",
  "title": "Orchestra AQ-2 adaptive risk profiler",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "owner",
    "methodology_neutral",
    "base_quality_dimensions",
    "orchestra_overlays",
    "risk_characteristics",
    "invariant_examples",
    "specialist_order",
    "assurance_order",
    "risk_rules",
    "invariant_rules",
    "authority"
  ],
  "properties": {
    "schema_version": {"const": "orchestra.adaptive-risk-profiler.v1"},
    "owner": {"const": "conductor"},
    "methodology_neutral": {"const": true},
    "base_quality_dimensions": {"$ref": "#/$defs/stringList"},
    "orchestra_overlays": {"$ref": "#/$defs/stringList"},
    "risk_characteristics": {"$ref": "#/$defs/stringList"},
    "invariant_examples": {"$ref": "#/$defs/stringList"},
    "specialist_order": {"$ref": "#/$defs/stringList"},
    "assurance_order": {"$ref": "#/$defs/stringList"},
    "risk_rules": {"$ref": "#/$defs/rules"},
    "invariant_rules": {"$ref": "#/$defs/rules"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_and_domain_observations_create_authority",
        "profiler_expands_authority",
        "provider_activation",
        "production_action",
        "protected_human_gates_nonwaivable"
      ],
      "properties": {
        "path_and_domain_observations_create_authority": {"const": false},
        "profiler_expands_authority": {"const": false},
        "provider_activation": {"const": false},
        "production_action": {"const": false},
        "protected_human_gates_nonwaivable": {"const": true}
      }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "rules": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assurance_classes", "specialists", "dagger_trigger"],
        "properties": {
          "assurance_classes": {"$ref": "#/$defs/stringList"},
          "specialists": {"$ref": "#/$defs/stringList"},
          "dagger_trigger": {"type": "boolean"}
        }
      }
    }
  }
}
