{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orchestra UI Engineering Translation Contract v1",
  "description": "Clockwork engineering translation of an accepted Cloak fidelity handoff with deterministic source identity and substantive ownership/boundary semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "owned_by",
    "source_handoff_ref",
    "source_revision_or_contract_identity",
    "component_boundaries",
    "state_ownership",
    "responsive_engineering",
    "composition_ownership",
    "layer_relationships",
    "data_flow_boundaries",
    "reusable_component_strategy",
    "integration_boundaries",
    "dependency_boundaries",
    "preserve",
    "unresolved_engineering_questions",
    "authority"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "orchestra.ui-engineering-translation.v1"
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "owned_by": {
      "const": "clockwork"
    },
    "source_handoff_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_revision_or_contract_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "component_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "component_id",
          "responsibility"
        ],
        "properties": {
          "component_id": {
            "type": "string",
            "minLength": 1
          },
          "responsibility": {
            "type": "string",
            "minLength": 1
          },
          "contains": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reuse_semantics": {
            "type": "string",
            "minLength": 1
          },
          "project_native_reuse": {
            "type": "boolean"
          }
        }
      }
    },
    "state_ownership": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "state_id",
          "owner",
          "scope",
          "lifecycle"
        ],
        "properties": {
          "state_id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "lifecycle": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "responsive_engineering": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "transformation_id",
          "owner",
          "strategy"
        ],
        "properties": {
          "transformation_id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "strategy": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "composition_ownership": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "composition_id",
          "owner",
          "strategy"
        ],
        "properties": {
          "composition_id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "strategy": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "layer_relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "layer_id",
          "owner",
          "relationship"
        ],
        "properties": {
          "layer_id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "relationship": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "data_flow_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "flow_id",
          "producer",
          "consumer",
          "contract"
        ],
        "properties": {
          "flow_id": {
            "type": "string",
            "minLength": 1
          },
          "producer": {
            "type": "string",
            "minLength": 1
          },
          "consumer": {
            "type": "string",
            "minLength": 1
          },
          "contract": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reusable_component_strategy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "decision",
          "reason"
        ],
        "properties": {
          "component_ref": {
            "type": "string",
            "minLength": 1
          },
          "evidence_identity": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "anyOf": [
          {
            "required": [
              "component_ref"
            ]
          },
          {
            "required": [
              "evidence_identity"
            ]
          }
        ]
      }
    },
    "integration_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "boundary_id",
          "direction",
          "contract",
          "rule"
        ],
        "properties": {
          "boundary_id": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "INPUT",
              "OUTPUT"
            ]
          },
          "contract": {
            "type": "string",
            "minLength": 1
          },
          "rule": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dependency_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "from",
          "to",
          "rule"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "rule": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "preserve": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unresolved_engineering_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visible_layer_redesign_authorized",
        "implementation_authorized",
        "dependency_adoption_authorized",
        "release_authorized"
      ],
      "properties": {
        "visible_layer_redesign_authorized": {
          "const": false
        },
        "implementation_authorized": {
          "const": false
        },
        "dependency_adoption_authorized": {
          "const": false
        },
        "release_authorized": {
          "const": false
        }
      }
    }
  }
}
