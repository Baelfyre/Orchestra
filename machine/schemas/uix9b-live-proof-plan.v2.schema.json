{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Baelfyre/Orchestra/blob/main/machine/schemas/uix9b-live-proof-plan.v2.schema.json",
  "title": "Orchestra UIX-9B V2 Live Proof Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "role", "canonical_sha", "fixture_digest", "task_digest", "validator_digest", "uix_guidance_digest", "evaluator_version", "evaluator_digest", "calibration_manifest", "provider_preparation", "task", "arms", "repetitions_per_arm", "total_valid_executions", "execution_order", "primary_metric_directions", "provider_accounting", "resource_ceiling_proposal", "retry_policy", "result_classification_rules", "external_mutation_boundary", "evidence_contract", "authority"],
  "properties": {
    "$schema": {"const": "../../../machine/schemas/uix9b-live-proof-plan.v2.schema.json"},
    "schema_version": {"const": "uix9b.live-proof-plan.v2"},
    "role": {"const": "UIX_9B_V2_LIVE_PROOF_PLAN"},
    "canonical_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "fixture_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validator_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uix_guidance_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluator_version": {"const": "uix9b-live-metric-evaluator-v2.0.0"},
    "evaluator_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "calibration_manifest": {"type": "string", "minLength": 1},
    "provider_preparation": {"$ref": "#/$defs/provider"},
    "task": {"type": "object", "additionalProperties": false, "required": ["path", "digest", "question", "model_self_rating", "subjective_visual_score"], "properties": {"path": {"type": "string"}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "question": {"type": "string", "minLength": 1}, "model_self_rating": {"const": false}, "subjective_visual_score": {"const": false}}},
    "arms": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/arm"}},
    "repetitions_per_arm": {"const": 3},
    "total_valid_executions": {"const": 6},
    "execution_order": {"const": ["A1", "B1", "B2", "A2", "A3", "B3"]},
    "primary_metric_directions": {"type": "object", "additionalProperties": false, "required": ["COMPONENT_REUSE", "DUPLICATE_COMPONENT_COUNT", "TOKEN_VIOLATIONS", "ARBITRARY_STYLE_DRIFT", "STATE_COVERAGE", "ASSET_PROVENANCE", "ASSET_SUBSTITUTION", "RESPONSIVE_CONTAINMENT", "ACCESSIBILITY_INVARIANTS", "UNRESOLVED_MAPPINGS", "REVISION_MISMATCH", "VISUAL_BASELINE_REPLACEMENT", "DETERMINISTIC_ACCEPTANCE"], "properties": {"COMPONENT_REUSE": {"const": "true_is_better"}, "DUPLICATE_COMPONENT_COUNT": {"const": "lower_is_better"}, "TOKEN_VIOLATIONS": {"const": "lower_is_better"}, "ARBITRARY_STYLE_DRIFT": {"const": "lower_is_better"}, "STATE_COVERAGE": {"const": "higher_is_better"}, "ASSET_PROVENANCE": {"const": "true_is_better"}, "ASSET_SUBSTITUTION": {"const": "false_is_better"}, "RESPONSIVE_CONTAINMENT": {"const": "true_is_better"}, "ACCESSIBILITY_INVARIANTS": {"const": "true_is_better"}, "UNRESOLVED_MAPPINGS": {"const": "lower_is_better"}, "REVISION_MISMATCH": {"const": "false_is_better"}, "VISUAL_BASELINE_REPLACEMENT": {"const": "false_is_better"}, "DETERMINISTIC_ACCEPTANCE": {"const": "true_is_better"}}},
    "provider_accounting": {"$ref": "#/$defs/accounting"},
    "resource_ceiling_proposal": {"$ref": "#/$defs/ceilings"},
    "retry_policy": {"type": "object", "additionalProperties": false, "required": ["valid_unfavorable_output", "provider_outage", "host_crash", "resource_ceiling_exceeded", "protocol_breach"], "properties": {"valid_unfavorable_output": {"const": "KEEP_RESULT_NO_RETRY_FOR_OUTCOME"}, "provider_outage": {"const": "CLASSIFY_EXPLICITLY_REPLACEMENT_ONLY_UNDER_FROZEN_OUTAGE_POLICY"}, "host_crash": {"const": "CLASSIFY_INVALID_INFRASTRUCTURE_RUN_REPLACEMENT_ALLOWED"}, "resource_ceiling_exceeded": {"const": "STOP_RUN_PRESERVE_EVIDENCE_DO_NOT_EXTEND_LIMIT"}, "protocol_breach": {"const": "FAIL_CLOSED_APPLY_FROZEN_INVALIDATION_POLICY"}}},
    "result_classification_rules": {"type": "object", "additionalProperties": false, "required": ["allowed", "benefit_established", "no_benefit_established", "mixed_or_inconclusive", "protocol_invalid", "no_single_metric_decides"], "properties": {"allowed": {"const": ["BENEFIT_ESTABLISHED", "NO_BENEFIT_ESTABLISHED", "MIXED_OR_INCONCLUSIVE", "PROTOCOL_INVALID"]}, "benefit_established": {"type": "array", "minItems": 5}, "no_benefit_established": {"type": "string"}, "mixed_or_inconclusive": {"type": "array", "minItems": 1}, "protocol_invalid": {"type": "string"}, "no_single_metric_decides": {"const": true}}},
    "external_mutation_boundary": {"type": "object", "additionalProperties": false, "required": ["external_repo_mutations", "protected_systems", "production_secrets_or_customer_data", "deployment", "policy_activation"], "properties": {"external_repo_mutations": {"const": 0}, "protected_systems": {"type": "array", "minItems": 1}, "production_secrets_or_customer_data": {"const": false}, "deployment": {"const": false}, "policy_activation": {"const": false}}},
    "evidence_contract": {"type": "object", "additionalProperties": false, "required": ["observation_schema", "metric_result_schema", "result_schema", "retention_paths", "screenshots_primary_scoring", "model_self_rating_included"], "properties": {"observation_schema": {"type": "string"}, "metric_result_schema": {"type": "string"}, "result_schema": {"type": "string"}, "retention_paths": {"type": "array", "minItems": 1}, "screenshots_primary_scoring": {"const": false}, "model_self_rating_included": {"const": false}}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["live_model_calls_authorized", "provider_calls_authorized", "uix9c_execution_authorized", "max_new_live_calls", "benefit_claim", "harm_claim", "directional_model_behavior_claim"], "properties": {"live_model_calls_authorized": {"const": false}, "provider_calls_authorized": {"const": false}, "uix9c_execution_authorized": {"const": false}, "max_new_live_calls": {"const": 0}, "benefit_claim": {"const": "NONE"}, "harm_claim": {"const": "NONE"}, "directional_model_behavior_claim": {"const": "NONE"}}}
  },
  "$defs": {
    "provider": {"type": "object", "additionalProperties": false, "required": ["provider", "model", "model_revision", "reasoning_effort", "codex_cli_version", "host_os", "host_architecture"], "properties": {"provider": {"const": "openai-codex"}, "model": {"const": "gpt-5.6-luna"}, "model_revision": {"type": "string", "minLength": 1}, "reasoning_effort": {"const": "xhigh"}, "codex_cli_version": {"type": "string", "minLength": 1}, "host_os": {"type": "string", "minLength": 1}, "host_architecture": {"type": "string", "minLength": 1}}},
    "arm": {"type": "object", "additionalProperties": false, "required": ["arm_id", "guidance_treatment", "fixture_digest", "task_digest", "validator_digest", "uix_guidance_digest_or_NONE", "only_intended_treatment_difference"], "properties": {"arm_id": {"enum": ["BASELINE_NO_ORCHESTRA_UIX_GUIDANCE", "GOVERNED_CANONICAL_UIX_1_8_GUIDANCE"]}, "guidance_treatment": {"enum": ["NO_ORCHESTRA_UIX_GUIDANCE", "CANONICAL_UIX_1_8_GUIDANCE"]}, "fixture_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "task_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "validator_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uix_guidance_digest_or_NONE": {"type": "string", "pattern": "^(NONE|[0-9a-f]{64})$"}, "only_intended_treatment_difference": {"const": true}}},
    "accounting": {"type": "object", "additionalProperties": false, "required": ["historical_counters", "new_campaign_authorization_counters", "immutable_limits"], "properties": {"historical_counters": {"$ref": "#/$defs/counters"}, "new_campaign_authorization_counters": {"$ref": "#/$defs/counters"}, "immutable_limits": {"$ref": "#/$defs/counters"}}},
    "counters": {"type": "object", "additionalProperties": false, "required": ["experimental_model_calls", "experimental_provider_calls", "nonexperimental_availability_probes", "total_provider_interactions", "invalid_infrastructure_retries"], "properties": {"experimental_model_calls": {"type": "integer", "minimum": 0}, "experimental_provider_calls": {"type": "integer", "minimum": 0}, "nonexperimental_availability_probes": {"type": "integer", "minimum": 0}, "total_provider_interactions": {"type": "integer", "minimum": 0}, "invalid_infrastructure_retries": {"type": "integer", "minimum": 0}}},
    "ceilings": {"type": "object", "additionalProperties": false, "required": ["max_model_calls_per_run", "max_total_model_calls", "max_experimental_provider_calls", "max_nonexperimental_availability_probes", "max_total_provider_interactions", "token_or_compute_ceiling", "per_run_timeout_seconds", "total_campaign_timeout_seconds", "max_retries_for_invalid_infrastructure_run", "max_external_repo_mutations"], "properties": {"max_model_calls_per_run": {"const": 1}, "max_total_model_calls": {"const": 6}, "max_experimental_provider_calls": {"const": 6}, "max_nonexperimental_availability_probes": {"const": 1}, "max_total_provider_interactions": {"const": 7}, "token_or_compute_ceiling": {"const": "MAX_TOTAL_TOKENS_120000_MAX_PER_RUN_20000"}, "per_run_timeout_seconds": {"const": 900}, "total_campaign_timeout_seconds": {"const": 7200}, "max_retries_for_invalid_infrastructure_run": {"const": 1}, "max_external_repo_mutations": {"const": 0}}}
 }
}
