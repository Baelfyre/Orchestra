{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Baelfyre/Orchestra/machine/schemas/historical-assurance-scope-exceptions.v1.schema.json",
  "title": "Orchestra historical assurance exact-scope exception registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "authority_class",
    "authority_source",
    "historical_gates",
    "scopes",
    "invariants"
  ],
  "properties": {
    "schema_version": {
      "const": "orchestra.historical-assurance-scope-exceptions.v1"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "authority_class": {
      "const": "HUMAN_POLICY"
    },
    "authority_source": {
      "type": "string",
      "minLength": 1
    },
    "historical_gates": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "enum": [
          "prai",
          "aq5",
          "aq7"
        ]
      }
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope_id",
          "status",
          "candidate_pr",
          "approved_base_sha",
          "approved_source_head_sha",
          "exact_paths",
          "anchor_paths",
          "authority_note"
        ],
        "properties": {
          "scope_id": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "status": {
            "const": "HUMAN_APPROVED_REGISTERED"
          },
          "candidate_pr": {
            "type": "integer",
            "minimum": 1
          },
          "approved_base_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "approved_source_head_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "exact_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "anchor_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "authority_note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "invariants": {
      "type": "object"
    }
  }
}
