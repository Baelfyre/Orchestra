{
  "$id": "https://orchestra.local/schemas/aq6-gate-coverage.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_sha": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "changed_paths": {"items": {"type": "string"}, "type": "array", "uniqueItems": true},
    "compliant": {"type": "boolean"},
    "decision_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "decision_id": {"minLength": 1, "type": "string"},
    "declared_assurance": {"items": {"type": "string"}, "type": "array", "uniqueItems": true},
    "declared_risks": {"items": {"type": "string"}, "type": "array", "uniqueItems": true},
    "evidence_receipt_ids": {"items": {"type": "string"}, "type": "array", "uniqueItems": true},
    "executed_gate_ids": {"items": {"type": "string"}, "type": "array", "uniqueItems": true},
    "executed_test_ids": {"items": {"type": "string"}, "type": "array", "uniqueItems": true},
    "failure_codes": {"items": {"type": "string"}, "type": "array", "uniqueItems": true},
    "generated_at": {"format": "date-time", "type": "string"},
    "manifest_id": {"minLength": 1, "type": "string"},
    "missing_assurance": {"items": {"type": "string"}, "type": "array", "uniqueItems": true},
    "missing_gate_ids": {"items": {"type": "string"}, "type": "array", "uniqueItems": true},
    "missing_risks": {"items": {"type": "string"}, "type": "array", "uniqueItems": true},
    "repository": {"minLength": 1, "type": "string"},
    "required_assurance": {"items": {"type": "string"}, "type": "array", "uniqueItems": true},
    "required_risks": {"items": {"type": "string"}, "type": "array", "uniqueItems": true},
    "result": {"enum": ["PASS", "FAIL"]},
    "schema_version": {"const": "orchestra.aq6-gate-coverage-decision.v1"},
    "source_ref": {"minLength": 1, "type": "string"},
    "tree_sha": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "uncovered_paths": {"items": {"type": "string"}, "type": "array", "uniqueItems": true},
    "work_item_ref": {"minLength": 1, "type": "string"},
    "covered_paths": {"items": {"type": "string"}, "type": "array", "uniqueItems": true}
  },
  "required": [
    "schema_version",
    "decision_id",
    "repository",
    "source_ref",
    "candidate_sha",
    "tree_sha",
    "work_item_ref",
    "manifest_id",
    "result",
    "compliant",
    "failure_codes",
    "changed_paths",
    "required_assurance",
    "required_risks",
    "declared_assurance",
    "declared_risks",
    "covered_paths",
    "uncovered_paths",
    "missing_assurance",
    "missing_risks",
    "executed_gate_ids",
    "missing_gate_ids",
    "executed_test_ids",
    "evidence_receipt_ids",
    "generated_at",
    "decision_digest"
  ],
  "title": "Orchestra AQ6 gate coverage decision",
  "type": "object"
}
