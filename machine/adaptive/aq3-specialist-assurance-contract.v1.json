{
  "schema_version": "orchestra.specialist-assurance-contract.v1",
  "owner": "conductor",
  "authority_model": "EVIDENCE_ONLY_NON_AUTHORIZING",
  "receipt_fields": [
    "source_identities",
    "development_mode",
    "changed_domains",
    "quality_dimensions",
    "risk_characteristics",
    "invariants",
    "selected_specialists",
    "required_assurance",
    "dagger_decision",
    "protected_gates",
    "next_transition_target",
    "authority_boundary",
    "risk_fingerprint"
  ],
