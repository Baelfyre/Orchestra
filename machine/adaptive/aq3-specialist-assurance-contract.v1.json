  "bounded_coordination": {
    "additions_are_explicit": true,
    "additions_are_registry_bound": true,
    "selection_grants_authority": false,
    "authority_expansion": false
  },
  "dagger_policy": {
    "trigger_source": "AQ2_RISK_AND_INVARIANT_RULES_PLUS_AQ3_CANONICAL_TRIGGERS",
    "risk_triggered": true,
    "aq3_risk_characteristics": [
      "AUTHORIZATION",
      "MULTI_TENANT",
      "PRIVILEGE_MUTATION",
      "CONCURRENCY",
      "MULTI_ACTOR",
      "AGGREGATE_INVARIANT",
      "STATE_MACHINE",
      "RETRY_IDEMPOTENCY",
      "RECOVERY_ROLLBACK",
      "EXTERNAL_INPUT",
      "PROVENANCE",
      "RESOURCE_PRESSURE"
    ],
    "aq3_quality_dimensions": ["DESTRUCTIVE_LIFECYCLE"],
    "aq3_material_behavior_markers": ["PARTIAL_FAILURE"],
    "aq2_triggers_preserved": true,
    "adversarial_assurance_added_if_missing": true,
    "harmless_copy_only_must_not_trigger": true,
    "execution_authorized": false,
    "required_selection_may_not_be_omitted": true,
    "overrouting_disposition": "FAIL_OR_WARN_OVERRouting_ACCORDING_TO_CANONICAL_POLICY"
  },
  "overseer_policy": {
    "reviewer": "overseer",
    "required_outputs": [
      "IMPLEMENTATION_CONTRACT_SATISFIED",
      "INVARIANT_PRESERVATION_SUFFICIENT"
    ],
    "independent_evidence_required": true,
    "implementer_self_certification_satisfies": false,
    "separate_attribution_required": true,
    "context_fields": [
      "candidate_ref",
      "work_item_ref",
      "freshness_ref",
      "version_ref"
    ],
    "review_binding_fields": [
      "receipt_fingerprint",
      "profile_risk_fingerprint",
      "evidence_ids",
      "candidate_ref",
      "work_item_ref",
      "freshness_ref",
      "version_ref"
    ],
    "recomputed_from_current_evidence": true
  },
  "arbiter_policy": {
    "required_set": "REQUIRED_ASSURANCE_SET",
    "actual_set": "ACTUAL_EVIDENCE_SET",
    "claimed_state": "CLAIMED_COMPLETION_STATE",
    "stale_evidence_blocks": true,
    "wrong_source_blocks": true,
    "weaker_evidence_blocks": true,
    "duplicate_logical_identity_counts_once": false,
    "green_ci_substitutes_for_security": false,
    "green_ci_substitutes_for_concurrency": false,
    "green_ci_substitutes_for_adversarial": false,
    "aq1_completion_escalation_allowed": false,
    "aq1_completion_validator": "orchestra_runtime.domain.adaptive.assurance.validate_completion_escalation",
    "aq1_evidence_required": true,
    "aq1_required_verifier_context": [
      "source_ref",
      "candidate_ref",
      "work_item_ref",
      "freshness_ref",
      "version_ref",
      "verified_authority_ref"
    ],
    "overseer_review_recomputed": true,
    "overseer_review_exact_binding_required": true
  },
  "source_truth_policy": {
    "labels": [
      "OBSERVED",
      "INFERRED",
      "DECIDED",
      "UNVERIFIED"
    ],
    "scribe_may_infer_historical_intent": false,
    "decided_claim_requires_authority": true
  },
  "specialist_boundary_rules": {
    "cipher_tenant_admin_may_mutate_global_authority": false,
    "chronicler_row_level_evidence_proves_tenant_wide_aggregate": false,
    "chronicler_aggregate_claim_requires": "REQUIRE_AGGREGATE_CONCURRENCY_ANALYSIS"
  },
  "failure_codes": [
    "FAIL_INDEPENDENT_ASSURANCE_REQUIRED",
    "FAIL_REQUIRED_DAGGER_OMITTED",
    "FAIL_OR_WARN_OVERRouting_ACCORDING_TO_CANONICAL_POLICY",
    "FAIL_REQUIRED_ASSURANCE_MISSING",
    "FAIL_SOURCE_TRUTH_VIOLATION",
    "FAIL_AUTHORITY_SCOPE_VIOLATION",
    "REQUIRE_AGGREGATE_CONCURRENCY_ANALYSIS",
    "FAIL_STALE_EVIDENCE",
    "FAIL_WRONG_SOURCE_EVIDENCE",
    "FAIL_WEAKER_EVIDENCE",
    "FAIL_DUPLICATE_EVIDENCE_IDENTITY",
    "FAIL_PROTECTED_GATE_UNSATISFIED",
    "FAIL_AQ1_COMPLETION_SCOPE",
    "FAIL_EVIDENCE_BINDING",
    "FAIL_EVIDENCE_PROVENANCE"
  ],
  "authority": {
    "receipt_authorizes_dispatch": false,
    "receipt_authorizes_execution": false,
    "receipt_expands_authority": false,
    "provider_activation": false,
    "production_action": false,
    "arbiter_transition_authority_created": false,
    "dagger_execution_authority_created": false
  }
}
