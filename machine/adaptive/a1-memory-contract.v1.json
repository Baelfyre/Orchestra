{
  "schema_version": "orchestra.adaptive-memory-contract.v1",
  "phase": "A1_LOCAL_ADAPTIVE_MEMORY_FOUNDATION",
  "authority": {
    "runtime_integration": "NONE",
    "routing_integration": "NONE",
    "specialist_context_integration": "NONE",
    "learned_policy_activation": "NONE",
    "provider_integration": "NONE",
    "training": "NONE",
    "repository_writes_from_normal_learning": false
  },
  "persistence": {
    "canonical_structured_state": "JSON",
    "append_only_observation_evidence": "JSONL",
    "default_local_root": "~/.orchestra/adaptive",
    "environment_override": "ORCHESTRA_ADAPTIVE_HOME",
    "store_must_be_outside_repository": true,
    "layout_version": 1,
    "sqlite": "DEFERRED_UNTIL_SCALE_QUERY_OR_CONCURRENCY_EVIDENCE_JUSTIFIES_IT",
    "toon": "DERIVED_NON_AUTHORITATIVE_ONLY_IF_INTRODUCED_LATER"
  },
  "scopes": [
    "global_user",
    "project",
    "specialist",
    "task_session"
  ],
  "evidence_classes": [
    "EXPLICIT_CURRENT_INSTRUCTION",
    "EXPLICIT_SCOPED_PREFERENCE",
    "GOVERNED_OUTCOME",
    "USER_FEEDBACK",
    "INFERRED_CANDIDATE"
  ],
  "observation_sources": {
    "EXPLICIT_PREFERENCE_SET": ["explicit_user_instruction"],
    "EXPLICIT_PREFERENCE_CORRECTED": ["explicit_user_instruction"],
    "EXPLICIT_PREFERENCE_REMOVED": ["explicit_user_correction"],
    "INFERRED_PATTERN_CANDIDATE": ["governed_pattern_materializer"],
    "GOVERNED_OUTCOME_RECORDED": ["orchestra_phase_retrospective"],
    "raw_conversation_is_authoritative_learning_evidence": false
  },
  "non_learnable_subject_roots": [
    "authority",
    "capability",
    "required_specialist",
    "governance",
    "human_gate",
    "security_prohibition",
    "mandatory_validation",
    "evidence_integrity",
    "audit_requirement",
    "fail_closed",
    "exact_head",
    "release_gate",
    "merge_gate",
    "privacy_restriction",
    "provider_restriction",
    "resource_ceiling"
  ],
  "materialization": {
    "governed_outcomes_directly_become_preferences": false,
    "explicit_preferences": "CONFIRMED_CONFIDENCE_1_0",
    "inferred_candidates": "CANDIDATE_ONLY_IN_A1",
    "automatic_inferred_promotion_api": false,
    "profile_is_derived_from_validated_observation_log": true,
    "profile_write_requires_exact_observation_head": true
  },
  "privacy": {
    "credential_like_values_rejected": true,
    "sensitive_key_fragments_rejected": true,
    "scope_delete_uses_local_compaction": true,
    "compaction_rechains_retained_observations": true,
    "compaction_invalidates_materialized_profile": true,
    "export_format": "JSON",
    "forensic_secure_erase_guaranteed": false,
    "retention_period": "CONFIGURATION_NOT_INVENTED_BY_A1",
    "expiry_pruning_supported": true
  },
  "migration_and_recovery": {
    "first_layout_version": 1,
    "unknown_observation_schema": "FAIL_CLOSED",
    "unknown_profile_schema": "FAIL_CLOSED",
    "profile_recovery": "REBUILD_FROM_HASH_VALIDATED_JSONL",
    "future_layout_migrations": "REQUIRE_EXPLICIT_VERSIONED_MIGRATION_CONTRACT"
  },
  "a2_boundary": {
    "adaptive_context_compiler": "NOT_IMPLEMENTED_IN_A1",
    "specialist_attachment_point": "AFTER_DETERMINISTIC_ROUTE_BINDING_AUTHORITY_CAPABILITY_AND_GOVERNANCE_CEILINGS_BEFORE_OPERATION_IF_A2_IS_SEPARATELY_AUTHORIZED",
    "a2_authorized": false
  },
  "schemas": [
    "machine/schemas/adaptive-observation.schema.json",
    "machine/schemas/adaptive-profile.schema.json",
    "machine/schemas/adaptive-export.schema.json",
    "machine/schemas/adaptive-store-meta.schema.json"
  ]
}
