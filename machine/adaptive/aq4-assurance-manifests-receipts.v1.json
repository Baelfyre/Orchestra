    "receipt_coverage_must_be_subset_of_slot": true,
    "generic_ci_substitutes_for_security": false,
    "generic_ci_substitutes_for_concurrency": false,
    "cross_platform_substitutes_for_security": false,
    "aq4_mutation_claim_requires_aq4_target": true
