    "MANIFEST_CANDIDATE_SHA == CURRENT_CANDIDATE_SHA",
    "MANIFEST_TREE_SHA == CURRENT_CANDIDATE_TREE",
    "MANIFEST_RISK_FINGERPRINT == QUALIFIED_AQ2_RISK_FINGERPRINT",
    "AQ2_REQUIRED_ASSURANCE_SUBSET_OF_MANIFEST",
    "AQ3_REQUIRED_ASSURANCE_SUBSET_OF_MANIFEST",
    "AQ3_SELECTED_SPECIALISTS_SUBSET_OF_MANIFEST",
    "MANIFEST_AUTHORITY_BOUNDARY <= CURRENT_AUTHORIZED_BOUNDARY",
    "RECEIPT_COVERAGE <= GATE_DECLARED_COVERAGE",
    "PASS_WITH_NONZERO_EXIT == REJECT",
    "SCHEMA_VALID != SEMANTICALLY_VALID"
